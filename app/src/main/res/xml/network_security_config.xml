<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permitir tráfico HTTP para el backend de Azure -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">autonexo-backend-akcsb5avacemdwh7.canadacentral-01.azurewebsites.net</domain>
    </domain-config>
    
    <!-- Configuración por defecto para HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>


